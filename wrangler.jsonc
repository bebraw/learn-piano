{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-piano-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-28",
  "build": {
    "command": "npm run build",
    "watch_dir": "src",
  },
  "assets": {
    "directory": ".generated/browser",
    "run_worker_first": ["/styles.css"],
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css"],
      "fallthrough": true,
    },
  ],
}
